pipeline {
    agent { label 'ci' }

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        skipDefaultCheckout(true)
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Context') {
            steps {
                sh '''
                    echo "Jenkins job: ${JOB_NAME} #${BUILD_NUMBER}"
                    echo "SCM branch: ${BRANCH_NAME:-development}"
                    echo "Pull request: ${CHANGE_ID:-not-a-pull-request}"
                    echo "Pull request target: ${CHANGE_TARGET:-not-a-pull-request}"
                    echo "Git commit: $(git rev-parse HEAD)"
                '''
            }
        }

        stage('Python Test') {
            steps {
                sh 'PYTHONPATH=src python3 -m unittest discover -s tests'
            }
        }

        stage('Terraform Format Check') {
            steps {
                sh 'terraform -chdir=infra/terraform/envs/dev fmt -check -recursive'
            }
        }

        stage('Terraform Init') {
            steps {
                sh 'terraform -chdir=infra/terraform/envs/dev init -backend=false'
            }
        }

        stage('Terraform Validate') {
            steps {
                sh 'terraform -chdir=infra/terraform/envs/dev validate'
            }
        }

        stage('Docker Compose Config Check') {
            steps {
                sh '''
                    if command -v docker-compose >/dev/null 2>&1; then
                        docker-compose -f infra/terraform/envs/dev/docker-compose.yaml config
                    else
                        docker compose -f infra/terraform/envs/dev/docker-compose.yaml config
                    fi
                '''
            }
        }
    }

    post {
        always {
            echo 'CI pipeline completed.'
        }
    }
}
